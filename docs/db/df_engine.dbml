Enum task_types {
    image
    video
}

Enum file_statuses {
    upload
    generation
}

Enum interior_styles {
    interior
    exterior
    interior_exterior
}

Enum shot_sizes {
    extreme_wide
    medium_wide
    wide
    medium
    medium_close_up
    close_up
    extreme_close_up
    insert
}

Enum prompt_statuses {
    processing
    completed
    failed
}

Enum prompt_types {
    assistant
    image
    image_edit
    video
    video_edit
    enhance
    keyframe
    keyframe_edit
    motion
    motion_edit
    element
    element_edit
}

Enum motion_types {
    static
    pan
    tilt
    push_in
    pull_back
    track
    crane
    handheld
}

Enum shot_angles {
  eye_level
  low
  high
  ground_level
  knee_level
  hip_level
  over_the_shoulder
  overhead
  top_view
  aerial
  dutch
  pov
}

Enum focal_lengths {
  mm_14
  mm_24
  mm_35
  mm_50
  mm_85
  mm_135
}

Enum element_types {
  environment
  character
  object
  styles
}

Enum time_of_days {
  pre_dawn
  sunrise
  morning
  midday
  afternoon
  golden_hour
  dusk
  blue_hour
  night
}

Enum lighting_moods {
  natural
  soft_diffused
  hard_high_contrast
  warm_practical
  moody_low_key
  high_key_bright
  silhouette_backlit
  neon
  overcast_flat
}

Enum shot_types {
    keyframe
    motion
}

Enum model_usage_types {
    text
    video
    image
}

Enum limit_reset_types {
    daily
    monthly
    weekly
}

Enum theme_types {
    dark
    light
}

Enum accent_types {
    signal
    violet
    teal
}

Enum language_types {
    indonesia
    english
}

Enum generation_file_types {
    video
    image
}

Table employees {
    id bigint [pk, increment]
}

Table users {
    id bigint [pk, increment]
}

Table projects {
    id bigint [pk, increment]
}

Table tasks {
    id bigint [pk, increment]
    uid varchar(36) [not null, unique]
    project_id integer [not null]
}

Table df_engine_project_settings {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    project_id integer [not null]
    token_usage_limit integer [not null]
    concurent_generations integer [not null]
    compose_input_max_chars integer [not null]
    storyboard_prompt_chars integer [not null]
    max_scene_per_storyboard integer [not null]
    max_shot_per_scene integer [not null]
    created_by integer [default: null]
    updated_by integer [default: null]
}


Table df_engine_api_keys {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    expires_at timestamp [default: null, note: "e.g: 2027-12-31T23:59:59Z"]
    uid varchar(36) [not null, unique]
    limit decimal(10, 2) [default: null]
    limit_reset limit_resets [default: null]
    key varchar(255) [not null, unique]
    hash varchar(255) [default: null]
    name varchar(255) [not null]
    description text [default: null]
    employee_id integer [default: null]
    employee_name varchar(255) [default: null]
    is_main boolean [not null, default: False, note: "This table supports multi employee_id and multi api_keys, create constraint is_main only can be choose 1 per api"]
    updated_at timestamp [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_api_key_snapshots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    expires_at timestamp [default: null, note: "e.g: 2027-12-31T23:59:59Z"]
    limit decimal(10, 2) [default: null]
    limit_reset limit_resets [default: null]
    uid varchar(36) [not null, unique]
    key varchar(255) [not null, unique]
    hash varchar(255) [default: null]
    name varchar(255) [not null]
    description text [default: null]
    employee_id integer [default: null, note: "Denormalized copy, no FK — archival record must survive employee deletion"]
    employee_name varchar(255) [default: null]
    updated_at timestamp [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_openrouter_logs {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    name varchar(255) [default: null]
    method varchar(10) [not null, note: "e.g. GET, POST, PUT, PATCH, DELETE"]
    endpoint varchar(255) [not null, note: "e.g. /keys, /keys/{hash}"]
    request_headers json [default: null, note: "SENSITIVE — stored raw, including the live OpenRouter management key used to authorize this call. Restrict read access."]
    request_payload json [default: null]
    response_status_code integer [default: null]
    response_headers json [default: null]
    response_body json [default: null, note: "SENSITIVE — may contain the raw OpenRouter key/hash from a /keys response. Restrict read access; mask before returning through any API."]
    error_message text [default: null, note: "Populated when the call raised (timeout, non-2xx, network error, etc.)."]
    duration_ms integer [default: null]
}

Table df_engine_api_key_rotation_issues {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    old_uid varchar(36) [not null, note: "df_engine_api_keys.uid this rotation was replacing — no FK, the old row is usually already deleted by the time this exists"]
    new_uid varchar(36) [default: null, note: "df_engine_api_keys.uid of the replacement, when it was successfully saved locally"]
    new_key_hash varchar(255) [default: null, note: "Set only for new_key_db_conflict — OpenRouter already created this key but the local row failed to save"]
    new_key_value varchar(255) [default: null, note: "SENSITIVE — raw key value, same case as new_key_hash. Restrict read access; mask before returning through any API."]
    issue_type varchar(50) [not null, note: "new_key_db_conflict | old_key_not_revoked | archive_failed"]
    detail text [default: null, note: "The underlying exception text"]
    resolved_at timestamp [default: null, note: "Null until a reconciliation job or human fixes the drift"]
}


Table df_engine_menus {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null, unique]
    description text [default: null]
    is_active boolean [not null, default: true]
    created_by integer [default: null]
    updated_by integer [default: null]
}


Table df_engine_features {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null, unique]
    description text [default: null]
    is_active boolean [not null, default: true]
    created_by integer [default: null]
    updated_by integer [default: null]
}


Table df_engine_feature_prompt_mappings {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    feature_id integer [not null]
    template_id integer [not null]
}


Table df_engine_menu_feature_mappings {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    feature_id integer [not null]
    menu_id integer [not null]
}



Table df_engine_prompt_templates {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    is_active boolean [not null, default: true]
    name varchar(255) [not null, unique]
    prompt text [not null, unique]
    description text [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}


Table df_engine_preferences {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    user_id bigint [unique, default: null]
    theme theme_types [not null, default: "dark"]
    accent accent_types [not null, default: "teal"]
    language language_types [not null, default: "english"]
    default_aspect_ratio varchar(20) [not null, default: "16:9", note: "One of: 16:9, 1:1, 9:16, 4:3, 3:4"]
    default_size varchar(20) [not null, default: "4K", note: "One of: 1K, 2K, 4K"]
    confirm_before_spending decimal(10, 2) [not null, default: 0.50, note: "Ask before any generation that costs more than this. No upper bound."]
}


Table df_engine_model_options {
    id bigint [pk, increment]
    sync_at timestamp [default: `now()`] // video, image, text
    deleted_at timestamp [default: null] // video, image, text
    name varchar(255) [not null, note: "Example: Muse-Spark"] // video, image, text
    created bigint [default: null] // video , image, text
    model_id varchar(255) [not null, note: "Example: meta/muse-spark-1.2"] // video, image, text
    description text [default: null] // video, image, text
    architecture json [default: null] // image, text
    type model_usage_types [not null]
    is_main boolean [default: null] // video, image, text
    is_enabled boolean [not null, default: false] // video, image, text
    is_available boolean [not null, default: true] // video, image, text
    supported_parameters json [default: null] // image, text
    default_parameters json [default: null] // text
    supports_streaming bool [default: null] // image
    supported_resolutions json [default: null] // video
    supported_aspect_ratios json [default: null] // video
    supported_sizes json [default: null] // video
    supported_durations json [default: null] // video
    supported_frame_images json [default: null] // video
    generate_audio boolean [default: null] // video
    allowed_passthrough_parameters json [default: null] // video
    pricing_skus json [default: null] // video
    pricing json [default: null] // text
    top_provider json [default: null] // text
    knowledge_cutoff date [default: null] // text
    expiration_date date [default: null] // text
    deleted_by bigint [default: null]
}



Table generation_prompts {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    archieved_at timestamp [default: null, note: "Only allowed to be archieved for assistant prompt types."]
    uid varchar(36) [not null, unique]
    key_id bigint [not null]
    task_id bigint [not null]
    model_id bigint [not null]
    keyframe_id bigint [default: null, note: "Will be filled if prompt source is from storyboard keyframe."]
    motion_id bigint [default: null, note: "Will be filled if prompt source is from storyboard keyframe."]
    element_file_id bigint [default: null, note: "Will be filled if prompt source is from storyboard element."]
    parent_assistant_id bigint [default: null, note: "The ID of the parent prompt if this prompt is a child of another prompt. Will be chained for assistant API calls."]
    x_min decimal(10, 2) [default: null, note: "The minimum x coordinate of the bounding box for the prompt. Will be filled if prompt source is from storyboard keyframe."]
    x_max decimal(10, 2) [default: null, note: "The maximum x coordinate of the bounding box for the prompt. Will be filled if prompt source is from storyboard keyframe."]
    y_min decimal(10, 2) [default: null, note: "The minimum y coordinate of the bounding box for the prompt. Will be filled if prompt source is from storyboard"]
    y_max decimal(10, 2) [default: null, note: "The maximum y coordinate of the bounding box for the prompt. Will be filled if prompt source is from storyboard keyframe."]
    raw text [not null, note: "The raw prompt text provided by the user."]
    enhanced text [default: null]
    status prompt_statuses [not null, default: "processing"]
    type prompt_types [not null, default: "generation", note: "The type of prompt this is. Can be assistant or generation."]
    model varchar(255) [not null, note: "The model used for this prompt. e.g.: 'gpt-4', 'dalle-2', etc."]
    parameter json [default: "{}", note: "A JSON object containing the parameters used for this prompt. e.g.: {\"temperature\": 0.7, \"max_tokens\": 100}"]
    endpoint varchar(255) [not null, note: "External endpoint. e.g.: 'https://openrouter.ai/api/v1/videos'"]
    response json [default: "{}", note: "A JSON object containing the responses generated for this prompt. e.g.: {\"text\": \"Generated text here\", \"image_url\": \"https://example.com/generated_image.png\"}"]
    status_code integer [default: null, note: "The HTTP status code returned by the model for this prompt. e.g.: 200 for success, 400 for bad request, etc."]
    token_usage integer [default: 0, not null]
    cost decimal(10, 2) [default: 0.00, not null, note: "The total cost incurred for this prompt."]
    created_by integer [not null, note: "The ID of the user who created this prompt."]
}

Table df_engine_upload_files {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    path text [not null]
    md5 varchar(255) [default: null]
    size bigint [not null]
    project_id bigint [not null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_upload_file_snapshots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    path text [not null]
    size bigint [not null]
    project_id bigint [not null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_generation_files {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    path text [not null]
    size bigint [not null]
    type generation_file_types [default: "image"]
    task_id bigint [default: null]
    project_id bigint [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_generation_file_snapshots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    path text [not null]
    size bigint [not null]
    type generation_file_types [default: "image"]
    task_id bigint [default: null]
    project_id bigint [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}

Table df_engine_prompt_enhancers {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    model_id bigint [not null]
    featureable_id bigint [not null]
    featureable_type bigint [not null, note: "Will be polymorph df_engine_features or df_engine_feature_snapshots"]
    sourceable_id bigint [not null]
    sourceable_type varchar(255) [not null, note: "Will be polymorph to df_engine_api_keys or df_engine_api_key_snapshots"]
    project_id bigint [default: null]
    task_id bigint [default: null]
    raw text [default: null]
    enhanced text [default: null]
    is_processing bool [not null, default: True]
    response json [default: null]
    status_code integer [default: null]
    token_usage integer [default: 0, not null]
    cost decimal(10, 2) [default: 0.00, not null, note: "The total cost incurred for this prompt."]
    created_by integer [default: null]
}


Table df_engine_image_generations {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    model_id bigint [not null]
    featureable_id bigint [not null]
    featureable_type bigint [not null, note: "Will be polymorph df_engine_features or df_engine_feature_snapshots"]
    sourceable_id bigint [not null]
    sourceable_type varchar(255) [not null, note: "Will be polymorph to df_engine_api_keys or df_engine_api_key_snapshots"]
    project_id bigint [default: null]
    task_id bigint [default: null]
    enhancer_id bigint [default: null, note: "If filled, df_engine_image_generations.prompt value will be overiden with value from df_engine_prompt_enhancers.enhanced"]
    x_min decimal(10, 2) [default: null]
    x_max decimal(10, 2) [default: null]
    y_min decimal(10, 2) [default: null]
    y_max decimal(10, 2) [default: null]
    prompt text [not null]
    parameter json [default: "{}", note: "Custom params given by available model id."]
    is_processing bool [not null, default: True]
    response json [default: null]
    status_code integer [default: null]
    token_usage integer [default: 0, not null]
    cost decimal(10, 2) [default: 0.00, not null, note: "The total cost incurred for this prompt."]
    created_by integer [default: null]
}


Table df_engine_upload_file_references {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    generation_id bigint [not null]
    file_id bigint [not null]

    note: "This table should be only fetch data with image type due to when generating image reference should also be images."
}


Table df_engine_image_generation_results {
    id bigint [pk, increment]
    uid varchar(36) [not null, unique]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    archieved_at timestamp [default: null]
    generation_id bigint [default: null]
    parent_id bigint [default: null]
    md5 varchar(255) [default: null]
    name varchar(255) [not null]
    path text [not null]
    size bigint [not null]
    is_main bool [default: true]
    created_by integer [default: null]
    updated_by integer [default: null]

    note: "Constraint per parent_id should only allowed 1 is_main."
}

Table df_engine_feature_snapshots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    uid varchar(36) [not null, unique]
    name varchar(255) [default: null]
    description text [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}


Table df_engine_prompt_template_snapshots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    updated_at timestamp [default: null]
    feature_snapshot_id bigint [not null]
    uid varchar(36) [not null, unique]
    name varchar(255) [default: null]
    prompt text [default: null]
    description text [default: null]
    created_by integer [default: null]
    updated_by integer [default: null]
}



Table df_engine_generation_favourites {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    project_id bigint [not null]
    user_id bigint [not null]
    generation_file_id bigint [not null]
}

Table df_engine_setting_logs {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    user_email varchar(255) [default: null]
    user_name varchar(255) [default: null]
    previous_data json [default: null]
    incoming_data json [default: null]
    ip_address varchar(45) [default: null]
    user_agent varchar(255) [default: null]
    created_by integer [default: null]
}


Table df_engine_generation_shares {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    generation_file_id bigint [not null]
    created_by integer [default: null]
}

Table df_engine_files {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    archieved_at timestamp [default: null, note: "Only allowed to be archieved file_status = generation, and only the owner can archieve it."]
    uid varchar(36) [not null, unique]
    task_id bigint [not null]
    project_id bigint [not null]
    prompt_id bigint [default: null, note: "The ID of the prompt that generated this file. Can be null if the file was not generated from a prompt."]
    generation_type task_types [default: null, note: "The type of generation that produced this file. Can be image, video. Will be null if the file was not generated from a prompt."]
    file_status file_statuses [not null, default: "generation"]
    upload_status prompt_statuses [not null, default: "processing", note: "When failed then upload to Udin's PC will be retried. When completed then the file will be moved to the final destination."]
    shared_global boolean [not null, default: false, note: "A boolean indicating whether this file is shared globally under projects radar. True if it is shared globally, false otherwise."]
    retry_count integer [default: 0, not null, note: "The number of times the upload has been retried. This is used to limit the number of retries for failed uploads."]
    size integer [not null, note: "The size of the generated file in bytes."]
    path varchar(255) [not null, note: "The path to the generated file. e.g.: '/generated/images/image1.png'"]
    created_by integer [not null, note: "The ID of the user who created this prompt."]
}

Table generation_references {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    prompt_id bigint [not null]
    file_id bigint [not null]
}

Table generation_favorite_files {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    task_id bigint [not null]
    file_id bigint [not null]
    favorited_by integer [not null, note: "The ID of the user who favorited this file."]
}

Table generation_galleries {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null, note: "Will be generated from prompt"]
    prompt_id bigint [not null, note: "The ID of the initial prompt that generated this gallery."]
    task_type task_types [not null, default: "image"]
    task_id bigint [not null]
    created_by integer [not null]
}

Table gallery_details {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    prompt_id bigint [not null]
    gallery_id bigint [not null]
    file_id bigint [not null]
    is_main boolean [not null, default: false, note: "A boolean indicating whether this file is the main file for the gallery. True if it is the main file, false otherwise."]
}

Table project_generation_shares {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    project_id bigint [not null]
    task_id bigint [not null]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    size integer [not null, note: "The size of the shared asset in bytes."]
    path varchar(255) [not null, note: "The path to the generated file. e.g.: '/dfactory/project_1/task_1/images/image1.png', '/dfactory/project_1/task_2/images/image2.png'"]
    created_by integer [not null]
}

Table elements_presets {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    name varchar(255) [not null]
    description text [default: null]
    element_type element_types [not null, default: "environment", note: "The type of the element preset. Can be environment, character, object, or styles."]
    project_id bigint [not null]
    task_id bigint [not null]
    created_by integer [not null]
}

Table element_files {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    preset_id bigint [not null]
    gallery_id bigint [default: null, note: "Handle image generations relation, from main galllery -> gallery_details.is_main = true"]
    is_main boolean [not null, default: false, note: "A boolean indicating whether this file is the main file for the gallery. True if it is the main file, false otherwise."]
}

Table storyboards {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    project_id bigint [not null]
    task_id bigint [not null]
    file_id bigint [default: null, note: "Will be used for thumbnail of storyboard folders."]
    name varchar(255) [not null]
    description text [default: null]
    created_by integer [not null]
}

Table storyboard_scenes {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    storyboard_id bigint [not null]
    element_id bigint [default: null, note: "The ID of the element used to generate this scene. Can be null if the scene was not generated from a prompt. Should be only allowed to set with element_type = environment."]
    name varchar(255) [not null, note: "The name of the scene. Can be null if the scene was not generated from a prompt. (e.g.: Scene 1, Scene 2, etc.)"]
    description text [default: null]
    location varchar(255) [default: null]
    duration decimal(10, 2) [default: 0, note: "The total duration of the storyboard in seconds. Will be calculated from the sum of all shots durations."]
    interior_style interior_styles [default: null, note: "The interior style of the scene. Can be null if the scene was not generated from a prompt."]
    time_of_day time_of_days [default: null]
    lighting_mood lighting_moods [default: null]
}

Table storyboard_shots {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    scene_id bigint [not null]
    name varchar(255) [not null, note: "The name of the scene. Can be null if the scene was not generated from a prompt. (e.g.: Scene 1, Scene 2, etc.)"]
    description text [default: null]
}

Table storyboard_keyframes {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    shot_id bigint [not null]
    gallery_id bigint [default: null]
    prompt text [default: null, note: "Placeholder prompt triggered by user if HIT storyboard generation."]
    vo text [default: null]
    shot_size shot_sizes [default: "medium", note: "The size of the shot for the scene. Can be null if the scene was not generated from a prompt."]
    shot_angels shot_angles [default: "eye_level", note: "The angle of the shot for the scene. Can be null if the scene was not generated from a prompt."]
    focal_length focal_lengths [default: "mm_50", note: "The focal length of the shot for the scene. Can be null if the scene was not generated from a prompt."]
}

Table storyboard_motions {
    id bigint [pk, increment]
    created_at timestamp [default: `now()`]
    uid varchar(36) [not null, unique]
    shot_id bigint [not null]
    gallery_id bigint [default: null]
    prompt text [default: null, note: "Placeholder prompt triggered by user if HIT storyboard generation."]
    duration decimal(10, 2) [default: 0, note: "The duration of the scene in seconds"]
    motion motion_types [default: "static", note: "The type of motion for the scene. Can be null if the scene was not generated from a prompt."]
}

