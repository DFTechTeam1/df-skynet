flowchart LR
    Start([Start])
    End([End])
    subgraph Client
        UI[Web app]
    end
    subgraph EngineServices
        Storyboards
        Elements
    end

    Start --> Client
    UI --> StoryboardMenu

    StoryboardMenu --> Storyboards
    Storyboards-->GetStoryboard[GET /storyboards/tasks/task_uid]
    GetStoryboard--> CheckUserRoles{CheckUserRoles}

    subgraph FetchStoryboards
        CheckUserRoles -. Staff .-> ListPersonalStorybards[Storyboard filtered by user_id and project_id]
        CheckUserRoles -. Overrider .-> ListAllStoryboards[Storyboard filtered by project_id]
    end
    ListPersonalStorybards-->End
    ListAllStoryboards-->End

    %% Create Storyboards
    Storyboards-->CreateStoryboard[POST /storyboards/tasks/task_uid]
    CreateStoryboard-->GetProjects
    GetProjects-.Not Ongoing.->RaiseProjectNotOngoingError[Raise error: Project is not ongoing]
    GetProjects-.Ongoing.->GetProjectTasks[Get Project Tasks or Song Lists]
    GetProjectTasks-.Completed.->RaiseProjectTaskCompletedError[Raise error: Project task is completed]
    GetProjectTasks-.Not Completed.->GetUsers
    GetUsers-->CheckUserResignation{CheckUserResignation}
    CheckUserResignation-.Resigned.->RaiseUserResignedError[Raise error: User has resigned]
    CheckUserResignation-.Still Active.->CheckUserRoles
    subgraph CreateStoryboards
        CheckUserRoles -. Staff .-> CheckUserTaskAssignment{CheckUserTaskAssignment}
        CheckUserRoles -. Overrider .-> CheckProjectSettings{CheckProjectSettings}
    end
    CheckUserTaskAssignment -. Not Assigned.->RaiseUserNotAssignedError[Raise error: User is not assigned to the task]
    CheckUserTaskAssignment -. Assigned.->CheckProjectSettings
    CheckProjectSettings-.Has Custom Project Setting.->CheckProjectSpendLimitation{CheckProjectSpendLimitation}
    CheckProjectSettings-.No Project Setting.->GetAdminSettings
    GetAdminSettings-->GetDefaultLimitationProjectClass
    GetDefaultLimitationProjectClass-->CheckProjectSpendLimitation
    CheckProjectSpendLimitation-.Reached Limit.->RaiseProjectSpendLimitationError[Raise error: Project spend limit reached]
    CheckProjectSpendLimitation-.Not Reached Limit.->GetDefaultTextModel[Get Assistant model or Enhancer model]
    GetDefaultTextModel-.None.->RaiseNoDefaultTextModelError[Raise error: No default model found]
    GetDefaultTextModel-.Has Default Model.->CheckUserAPIKey{CheckUserAPIKey}

    jos-->End
